{
  "name": "t3mp3st",
  "version": "1.0.0-defensive",
  "description": "T3MP3ST defensive profile: white-box code analysis and passive posture checks for systems you own",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/",
    "DEFENSIVE.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run src",
    "server": "node dist/server.js",
    "tools": "node dist/cli.js tools",
    "assess": "node dist/cli.js assess"
  },
  "bin": {
    "t3mp3st": "./dist/cli.js",
    "tempest": "./dist/cli.js"
  },
  "keywords": [
    "security",
    "sast",
    "appsec",
    "defensive",
    "posture",
    "multi-agent",
    "llm"
  ],
  "author": "t3mp3st contributors",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seivad/T3MP3ST.git"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "conf": "^12.0.0",
    "eventemitter3": "^5.0.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
